  const px=(i,j)=>[(i+.5)*PIX*PXM,(j+.5)*PIX*PXM];
  for(let Lv=185;Lv<=215;Lv++){
    for(let j=0;j<NY-1;j++)for(let i=0;i<NX-1;i++){
      const a=sm[j*NX+i],b=sm[j*NX+i+1],c=sm[(j+1)*NX+i+1],d=sm[(j+1)*NX+i];
      const mn=Math.min(a,b,c,d), mx=Math.max(a,b,c,d); if(Lv<mn||Lv>=mx)continue;
      const pts=[]; const edge=(v1,v2,p1,p2)=>{ if((v1<Lv)!==(v2<Lv)){const t=(Lv-v1)/(v2-v1); pts.push([p1[0]+(p2[0]-p1[0])*t,p1[1]+(p2[1]-p1[1])*t]);}};
      const A=px(i,j),B=px(i+1,j),C=px(i+1,j+1),D=px(i,j+1);
      edge(a,b,A,B); edge(b,c,B,C); edge(c,d,C,D); edge(d,a,D,A);
