    const sp=(keys.ShiftLeft||keys.ShiftRight?14:4.5)*(fly?3:1);
    const f=(keys.KeyW||keys.ArrowUp?1:0)-(keys.KeyS||keys.ArrowDown?1:0), r=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0);
    if(f) pl.moveForward(f*sp*dt); if(r) pl.moveRight(r*sp*dt);
    const X=Math.max(OX+8,Math.min(-OX-8,camera.position.x)), Z=Math.max(OZ+8,Math.min(-OZ-8,camera.position.z));
    camera.position.x=X; camera.position.z=Z;
