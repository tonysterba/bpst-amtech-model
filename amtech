  <div style="display:flex;gap:6px;margin-top:6px;flex-wrap:nowrap">
    <button id="bOrbit" class="on">Orbit</button>
    <button id="bPov">POV</button>
    <button id="bFly">✈ Cirrus</button>
  </div>

  <h2>Legenda a vrstvy</h2>
  <div class="legend" id="legend"></div>

  <details class="podklady"><summary><h2 style="display:inline">Podklady a zobrazení</h2></summary>
  <label class="row"><input type="checkbox" id="lKopu"> Pozemkové úpravy (KoPÚ návrh)</label>
  <label class="row" style="margin-left:22px"><input type="checkbox" id="lKopuLbl"> popisky pozemkových úprav</label>
  <label class="row"><input type="checkbox" id="lOrto" checked> Ortofoto</label>
  <label class="row"><input type="checkbox" id="lBp" checked> Hranice parcel uvnitř areálu</label>
  <label class="row"><input type="checkbox" id="lCad"> Hranice parcel okolí</label>
  <label class="row"><input type="checkbox" id="lCont" checked> Vrstevnice 1 m (silně 5 m)</label>
  <label class="row"><input type="checkbox" id="lD55new" checked> D55 dostavěná</label>
  <label class="row"><input type="checkbox" id="lPasD55" checked> Ochranné pásmo D55 (≈ 100 m od osy, orientačně)</label>
  <label class="row"><input type="checkbox" id="lPasVVN" checked> Ochranné pásmo VVN 110 kV (≈ ±20 m od osy, orientačně)</label>
  <label class="row"><input type="checkbox" id="lSlope"> Sklon terénu</label>
  <label class="row"><input type="checkbox" id="lVeg" checked> Zeleň</label>
  <label class="row"><input type="checkbox" id="lLabels" checked> Popisky</label>
  <label class="row"><input type="checkbox" id="lShadow" checked> Stíny</label>

  <h2>Převýšení terénu <span id="exV">1×</span></h2>
  <input type="range" id="exag" min="1" max="4" step="0.5" value="1">
  <h2>Čas dne <span id="hV">14:00</span></h2>
  <input type="range" id="hour" min="6" max="19" step="0.25" value="14">
  <div class="legend" id="slopeLegend" style="display:none;margin-top:6px"></div>
  </details>
</div>

<div id="hud" class="panel">
  <div>Výška: <b id="hZ">–</b></div>
  <div>Sklon: <b id="hS">–</b></div>
  <div>S-JTSK: <b id="hXY">–</b></div>
</div>
<div id="help" class="panel">Orbit: myš – otáčení, pravé tl. – posun, kolečko – zoom.<br>POV: klik do scény (nebo tažení), <b>W A S D</b> pohyb, <b>Shift</b> rychle, <b>F</b> let, <b>Space/C</b> výš/níž, <b>Esc</b> uvolnit myš.</div>
<canvas id="cockpit" style="display:none;position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:3"></canvas>
<svg id="north" viewBox="0 0 46 46"><circle cx="23" cy="23" r="21" fill="rgba(16,21,28,.7)" stroke="rgba(255,255,255,.4)"/><g id="needle"><path d="M23 6 L29 26 L23 22 L17 26Z" fill="#e5484d"/><path d="M23 40 L29 26 L23 22 L17 26Z" fill="#cfd6dd"/></g></svg>

<script type="importmap">
{ "imports": {
  "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
  "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
} }
</script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { PointerLockControls } from 'three/addons/controls/PointerLockControls.js';

const $ = id => document.getElementById(id);
const fail = m => { const e=$('err'); e.style.display='block'; e.textContent=m; $('loading').style.display='none'; };

// ---------- geo ----------
const BB = [-541800,-1180400,-540550,-1179600];     // xmin,ymin,xmax,ymax (S-JTSK, GIS osy x doprava, y nahoru)
const NX = 625, NY = 400, PIX = 2, CX = -541175, CY = -1180000, Z0 = 200;
const WM = NX*PIX, HM = NY*PIX, OX = -(NX-1)*PIX/2, OZ = -(NY-1)*PIX/2;   // rozsah modelu 1250 × 800 m
const toLocal = (x,y) => [x-CX, -(y-CY)];
const toGis   = (X,Z) => [X+CX, -Z+CY];
const GRID = 4.65;   // stupně: severní směr sítě S-JTSK je vůči skutečnému severu natočen o ~4,65° (ověřeno podle haly st. 2491)
// projektový souřadnicový systém campusu: e = skutečný východ, n = skutečný sever, počátek OG
const OG=[-541000,-1179850], UE=[Math.sin((90+GRID)*Math.PI/180),Math.cos((90+GRID)*Math.PI/180)], UN=[Math.sin(GRID*Math.PI/180),Math.cos(GRID*Math.PI/180)];
const enToGis=(e,n)=>[OG[0]+e*UE[0]+n*UN[0], OG[1]+e*UE[1]+n*UN[1]];
const gisToEn=(x,y)=>{const dx=x-OG[0],dy=y-OG[1]; return [dx*UE[0]+dy*UE[1], dx*UN[0]+dy*UN[1]];};
const enToLocal=(e,n)=>{const [x,y]=enToGis(e,n); return toLocal(x,y);};

const PXM = 2.56, TW = Math.round(WM*PXM), TH = Math.round(HM*PXM);   // textura 3200 × 2048 px
const gisToPx = (x,y) => [ (x-BB[0])*PXM, (BB[3]-y)*PXM ];

let dem, nd, overlay, ortoImg; const LOGO={};
async function load(){
  const [a,b,c] = await Promise.all([
    fetch('dem.bin?v=3').then(r=>r.arrayBuffer()),
    fetch('ndsm.bin?v=3').then(r=>r.arrayBuffer()),
    fetch('overlay.json?v=9zr').then(r=>r.json())
  ]);
  dem = new Uint16Array(a); nd = new Uint8Array(b); overlay = c;
  const li=src=>new Promise((res,rej)=>{ const im=new Image(); im.onload=()=>res(im); im.onerror=()=>rej(new Error(src)); im.src=src; });
  LOGO.uhcar=await li('logos/uhcar.svg?v=3'); LOGO.cervinka=await li('logos/cervinka.png?v=3'); LOGO.nobility=await li('logos/nobility.png?v=3');
  ortoImg = await new Promise((res,rej)=>{ const im=new Image(); im.onload=()=>res(im); im.onerror=()=>rej(new Error('orto.jpg')); im.src='orto.jpg?v=3'; });
}
try { await load(); } catch(e){ fail('Nepodařilo se načíst data: '+e.message+' (spusť přes http server, ne z file://)'); throw e; }

// výškové pole: HB = stávající terén, HD = terén po terénních úpravách (návrh), HH = aktuálně zobrazené
const HB=new Float32Array(NX*NY); for(let k=0;k<NX*NY;k++) HB[k]=dem[k]/100+150;
const HD=new Float32Array(HB);
let HH=HB;
const H = (i,j) => HH[j*NX+i];
const Hs = (i,j) => H(Math.max(0,Math.min(NX-1,i)),Math.max(0,Math.min(NY-1,j)));
function ground(X,Z){      // bilineárně, m n.m. v místních souřadnicích
  const fi = (X-OX)/PIX, fj = (Z-OZ)/PIX;
  const i=Math.floor(fi), j=Math.floor(fj), tx=fi-i, tz=fj-j;
  const a=Hs(i,j)*(1-tx)+Hs(i+1,j)*tx, b=Hs(i,j+1)*(1-tx)+Hs(i+1,j+1)*tx;
  return a*(1-tz)+b*tz;
}
function slopeAt(X,Z){   // % a směr svahu (azimut od severu)
  const e=2, gx=(ground(X+e,Z)-ground(X-e,Z))/(2*e), gz=(ground(X,Z+e)-ground(X,Z-e))/(2*e);
  const s=Math.hypot(gx,gz)*100;
  return {s, az:(Math.atan2(-gx,gz)*180/Math.PI+360-GRID+360)%360};
}
function pip(x,y,ring){let c=false;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const [xi,yi]=ring[i],[xj,yj]=ring[j];if((yi>y)!==(yj>y)&&x<(xj-xi)*(y-yi)/(yj-yi)+xi)c=!c;}return c;}

// ---------- návrh B: program a terénní úpravy ----------
const BLD = [
  {id:'A1',type:'A',name:'A1 · R&D, laboratoře, vedení',   e0:-36,e1:18, n0:34, n1:66, level:202.8, fl:2, col:'#4aa3ff'},
  {id:'A4',type:'A',name:'A4 · Inženýrské kanceláře',       e0:-36,e1:10, n0:2,  n1:32, level:202.8, fl:2, col:'#4aa3ff'},
  {id:'A3',type:'A',name:'A3 · Campus hub (jídelna, šatny, wellness)', e0:24,e1:74, n0:4, n1:32, level:200.0, fl:2, col:'#7bd88f'},
  {id:'A2',type:'A',name:'A2 · Demo a školicí centrum, showroom', e0:88,e1:134,n0:6, n1:48, level:197.8, fl:2, col:'#f5a623'},
  {id:'B',type:'B',name:'B · Technologická a servisní hala (výroba, servis, expedice)', e0:6,e1:66,n0:-118,n1:-26,level:199.9, fl:1, h:12, col:'#c08cf0'}   // spojená B1+B2; východní hrana ≥ 20 m od osy VVN 110 kV
];
const SURF = [   // zpevněné plochy a pomocné pády pro terénní úpravy
  {id:'plaza', name:'Náměstí (A-plaza)', e0:24,e1:84, n0:34,n1:66, level:199.6, col:'rgba(226,214,188,.95)'},
  {id:'PA',    name:'Zásobovací dvůr (expedice)', e0:66,e1:95, n0:-100,n1:-28, level:199.0, col:'rgba(70,75,82,.92)'},
  {id:'F',     name:'Vjezdové náměstí',  e0:86,e1:110,n0:-120,n1:-100, level:197.4, col:'rgba(214,206,190,.96)'},
  {id:'PE1',   name:'Parkoviště PE1 (podél D55, pod vedením VVN)', e0:112,e1:136,n0:-70,n1:-8, level:198.4, col:'rgba(92,98,106,.92)', park:true},
  {id:'PE2',   name:'Parkoviště PE2 (podél D55)', e0:112,e1:120,n0:-94,n1:-74, level:198.2, col:'rgba(92,98,106,.92)', park:true},
  {id:'P2',    name:'Parkoviště P2 (návštěvy)', e0:88,e1:144,n0:50,n1:62, level:197.4, col:'rgba(92,98,106,.92)', park:true},
  {id:'P3',    name:'Parkoviště P3 (podél D55)', e0:137,e1:146,n0:8,n1:48, level:196.6, col:'rgba(92,98,106,.92)', park:true},
  {id:'prom1', name:'Promenáda A4–A3',   e0:10,e1:24, n0:2,n1:32, level:201.0, col:'rgba(210,200,178,.9)'},
  {id:'prom2', name:'Promenáda A3–A2',   e0:74,e1:88, n0:6, n1:32, level:198.9, col:'rgba(210,200,178,.9)'}
];
const PADS=[...BLD,...SURF];
let SCENA_PLAN=false;   // varianta Budova A (nahrazuje st. 1419/18): terén se urovná pod budovou a manipulační plochou
const PLAN_PAD={id:'BAPAD',e0:-319,e1:-98,n0:-8,n1:77,level:0};
{ let sum=0,cnt=0; for(let e=-298;e<=-130.4;e+=6)for(let n=14;n<=74;n+=6){ const [X,Z]=enToLocal(e,n); sum+=ground(X,Z); cnt++; } PLAN_PAD.level=sum/cnt; }

// ---------- vedení VVN 110 kV (ZABAGED, V545/V546) ----------
const HV=overlay.power.hv, PYL=overlay.power.pylons.filter(p=>!(Math.abs(p[0]+541025.7)<1&&Math.abs(p[1]+1180086)<1)).sort((a,b)=>b[0]-a[0]);
const HV_BAND=20;   // orientační vzdálenost od osy, kde je nutný souhlas provozovatele (pásmo 12–15 m od krajního vodiče + rozpětí); k ověření
function distToHV(x,y){ let best=1e9; for(let i=0;i<HV.length-1;i++){ const [ax,ay]=HV[i],[bx,by]=HV[i+1],dx=bx-ax,dy=by-ay; const t=Math.max(0,Math.min(1,((x-ax)*dx+(y-ay)*dy)/(dx*dx+dy*dy))); best=Math.min(best,Math.hypot(x-ax-t*dx,y-ay-t*dy)); } return best; }
function minDistRectHV(r){ let best=1e9; for(let i=0;i<=60;i++){ const t=i/60; for(const [e,n] of [[r.e0+(r.e1-r.e0)*t,r.n0],[r.e0+(r.e1-r.e0)*t,r.n1],[r.e0,r.n0+(r.n1-r.n0)*t],[r.e1,r.n0+(r.n1-r.n0)*t]]){ const [x,y]=enToGis(e,n); best=Math.min(best,distToHV(x,y)); } } return best; }

function gradeTerrain(){
  // každá buňka patří k nejbližšímu padu; svah úprav 1:3
  const hall=overlay.parcels.find(p=>p.k==='st.2491');
  for(let j=0;j<NY;j++)for(let i=0;i<NX;i++){
    const [x,y]=toGis(OX+i*PIX,OZ+j*PIX); const [e,n]=gisToEn(x,y);
    let best=null,bd=1e9;
    for(const p of (SCENA_PLAN?[...PADS,PLAN_PAD]:PADS)){
      const dx=Math.max(p.e0-e,0,e-p.e1), dn=Math.max(p.n0-n,0,n-p.n1), d=Math.hypot(dx,dn);
      if(d<bd){bd=d;best=p;}
    }
    const o=HB[j*NX+i]; let v=o;
    if(best&&bd<40){ v = bd===0 ? best.level : (o>best.level ? Math.min(o,best.level+bd/3) : Math.max(o,best.level-bd/3)); }
    HD[j*NX+i]=v;
  }
}
gradeTerrain();
// bilance zemních prací a zásahy mimo perimetr
const perimRings=[...overlay.parcels.filter(p=>['pozemek','hala','prijezd2'].includes(p.c)).flatMap(p=>p.r), overlay.sold16];
let cutV=0, fillV=0, outsideA=0;
for(let j=0;j<NY;j++)for(let i=0;i<NX;i++){
  const dz=HD[j*NX+i]-HB[j*NX+i]; if(Math.abs(dz)<0.02)continue;
  if(dz<0) cutV-=dz*PIX*PIX; else fillV+=dz*PIX*PIX;
  const [x,y]=toGis(OX+i*PIX,OZ+j*PIX); if(!perimRings.some(r=>pip(x,y,r))) outsideA+=PIX*PIX;
}

// ---------- scene ----------
const canvas=$('c');
const renderer=new THREE.WebGLRenderer({canvas,antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.outputColorSpace=THREE.SRGBColorSpace;
const scene=new THREE.Scene();
scene.background=new THREE.Color(0xa9c4dc);
scene.fog=new THREE.Fog(0xa9c4dc,900,2600);
const camera=new THREE.PerspectiveCamera(55,1,1,6000);

const hemi=new THREE.HemisphereLight(0xdfeaff,0x6b5f4c,.75); scene.add(hemi);
const sun=new THREE.DirectionalLight(0xfff2dd,2.2); scene.add(sun); scene.add(sun.target);
sun.castShadow=true; sun.shadow.mapSize.set(4096,4096);
const sc=sun.shadow.camera; sc.left=-660; sc.right=660; sc.top=420; sc.bottom=-420; sc.near=10; sc.far=1800; sun.shadow.bias=-0.0006; sun.shadow.normalBias=0.6;

const world=new THREE.Group(); scene.add(world);

// terén
const geo=new THREE.PlaneGeometry((NX-1)*PIX,(NY-1)*PIX,NX-1,NY-1); geo.rotateX(-Math.PI/2);
function applyHeights(){
  const pos=geo.attributes.position, uv=geo.attributes.uv;
  for(let j=0;j<NY;j++)for(let i=0;i<NX;i++){
    const k=j*NX+i; pos.setY(k,H(i,j)-Z0);
    uv.setXY(k,(pos.getX(k)+WM/2)/WM, 1-(pos.getZ(k)+HM/2)/HM);
  }
  pos.needsUpdate=true; geo.computeVertexNormals();
}
applyHeights();
const tex=new THREE.CanvasTexture(document.createElement('canvas'));
tex.colorSpace=THREE.SRGBColorSpace; tex.anisotropy=renderer.capabilities.getMaxAnisotropy();
const terrain=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({map:tex,roughness:1,metalness:0}));
terrain.receiveShadow=true; world.add(terrain);

// ---------- kategorie ----------
const CAT = {
  pozemek:{name:'Pozemek campusu (7461/6, 7, 13, 14)',fill:'rgba(245,166,35,.22)',line:'#ffb020'},
  hala:{name:'Hala st. 2491 (k demolici)',fill:'rgba(80,140,255,.35)',line:'#6fa0ff'},
  paterni:{name:'↳ prodávaná část páteřní komunikace 7461/16',fill:'rgba(245,166,35,.40)',line:'#ffb020'},
