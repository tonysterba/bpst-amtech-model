  <div style="display:flex;gap:6px;margin-bottom:8px">
    <button id="mNow" style="flex:1;white-space:nowrap">Stav dnes</button>
    <button id="mDes" class="on" style="flex:1;white-space:nowrap" title="Návrh B: zastavěná plocha ≈ 12 000 m²">Návrh B</button>
    <button id="bScenA" style="flex:1;white-space:nowrap" title="Plánovaná Budova A nahradí st. 1419/18 (návrh, výstavba 2027)">Budova A</button>
  </div>
  <div class="stat" id="stats"></div>
  <div id="program" style="display:none;margin-top:10px"></div>

  <h2>Pohledy</h2>
