<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Business Park Staré Město · Amtech campus</title>
<style>
  :root{
    --bg:#10151c; --panel:rgba(16,21,28,.88); --ink:#e8edf2; --muted:#9aa7b4; --line:rgba(255,255,255,.14);
    --acc:#1491F9; --warn:#f5a623;
  }
  @media (prefers-color-scheme: light){
    :root{ --bg:#dfe6ee; --panel:rgba(255,255,255,.92); --ink:#14202b; --muted:#566574; --line:rgba(0,0,0,.14); }
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font:14px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;overflow:hidden}
  #c{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}
  .panel{position:fixed;background:var(--panel);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
  #side{top:12px;left:12px;width:310px;max-height:calc(100% - 24px);overflow:auto}
  #side h1{font-size:15px;margin:0 0 2px}
  #side .sub{color:var(--muted);font-size:12px;margin-bottom:10px}
  #side h2{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}
  label.row{display:flex;gap:8px;align-items:center;padding:3px 0;cursor:pointer}
  input[type=range]{width:100%}
  button{font:inherit;color:var(--ink);background:transparent;border:1px solid var(--line);border-radius:8px;padding:6px 9px;cursor:pointer;text-align:left}
  button:hover{border-color:var(--acc)}
  button.on{background:var(--acc);border-color:var(--acc);color:#fff}
  .presets{display:grid;gap:5px}
  .legend div{display:flex;gap:8px;align-items:center;font-size:12.5px;padding:2px 0}
  .lhd{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:9px 0 3px}
  .lrow{display:flex;gap:8px;align-items:flex-start;padding:2px 0;cursor:pointer;font-size:12.5px}
  .lrow small{display:block;color:var(--muted);font-size:11.3px;line-height:1.3}
  .lrow input{margin-top:3px}
  .lsub{margin-left:44px;font-size:11.5px;color:var(--muted);display:flex;gap:6px;align-items:center;padding:1px 0}
  .lsub2{margin-left:44px;font-size:11.5px;color:var(--muted)}
  .sw{width:14px;height:14px;border-radius:3px;border:1px solid rgba(255,255,255,.5);flex:none}
  .stat{font-size:12.5px;color:var(--muted)} .stat b{color:var(--ink)}
  #stats,#program{display:none !important}   /* souhrnné údaje a program campusu v panelu nezobrazovat (požadavek uživatele) */
  #program table{width:100%;border-collapse:collapse;font-size:12px}
  #program td{padding:2px 0;vertical-align:top} #program td:last-child{text-align:right;white-space:nowrap;color:var(--muted)}
  #program .tot td{border-top:1px solid var(--line);padding-top:4px;color:var(--ink);font-weight:600}
  #hud{right:12px;top:12px;font-size:12.5px;min-width:200px}
  #hud b{color:var(--ink)}
  #help{right:12px;bottom:12px;font-size:12px;color:var(--muted);max-width:290px}
  #toggle{display:none}
  #err{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);padding:16px;background:#7a1f1f;color:#fff;border-radius:10px;display:none;max-width:80%}
  #north{position:fixed;right:20px;bottom:130px;width:46px;height:46px;pointer-events:none}
  @media (max-width:720px){
    #side{width:calc(100% - 24px);max-height:55%;top:auto;bottom:12px}
    #side.collapsed{max-height:42px;overflow:hidden}
    #toggle{display:block;position:fixed;top:12px;left:12px;z-index:5}
    #hud{top:60px;right:12px;min-width:0} #help{display:none} #north{bottom:auto;top:12px;right:12px}
  }
  #loading{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:var(--bg);z-index:9;color:var(--muted)}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="loading">Načítám terén a ortofoto…</div>
<div id="err"></div>

<button id="toggle" class="panel" onclick="document.getElementById('side').classList.toggle('collapsed')">☰ Menu</button>
<div id="side" class="panel">
  <h1>Platforma Amtech campus</h1>
